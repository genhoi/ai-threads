#!/usr/bin/env python3
"""Заглушка grok: печатает поток streaming-messages-json."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from stub_lib import (answer_text, digest_sources, fail_or_hang, is_digest,
                      journals_from,
                      mode, out, pause_if_slow)


def main() -> None:
    argv = sys.argv[1:]
    if argv[:1] == ["models"]:
        print("Default model: grok-test\n\nAvailable models:\n  * grok-test (default)\n  - grok-test-fast")
        return
    prompt = argv[argv.index("-p") + 1] if "-p" in argv else ""
    digest = is_digest(prompt)
    garbage = mode() == "garbage"

    slow = fail_or_hang()
    paths = journals_from(digest_sources(prompt))
    if not paths:
        paths = ["/nonexistent/journal.jsonl"]
    if len(paths) == 1:
        paths = paths * 2
    paths = paths[:2]
    out({"type": "system", "subtype": "init",
         "session_id": "stub-grok-session", "model": "grok-stub",
         "cwd": "/tmp", "permissionMode": "bypassPermissions",
         "tools": ["read_file"]})
    for i, path in enumerate(paths):
        out({"type": "assistant", "message": {
            "id": f"msg_{i}", "type": "message", "role": "assistant",
            "model": "grok-stub",
            "content": [{"type": "tool_use", "id": f"call_{i}",
                         "name": "read_file",
                         "input": {"target_file": path}}]},
            "session_id": "stub-grok-session"})
        if not slow:
            out({"type": "user", "message": {"role": "user", "content": [{
                "type": "tool_result", "tool_use_id": f"call_{i}",
                "content": '{"type":"ReadFile","FileContent":{"content":"строка журнала"}'}]},
                "session_id": "stub-grok-session"})
    if slow:
        pause_if_slow()
        for i, path in enumerate(paths):
            out({"type": "user", "message": {"role": "user", "content": [{
                "type": "tool_result", "tool_use_id": f"call_{i}",
                "content": '{"type":"ReadFile","FileContent":{"content":"строка журнала"}'}]},
                "session_id": "stub-grok-session"})
    out({"type": "assistant", "message": {
        "id": "msg_final", "type": "message", "role": "assistant",
        "model": "grok-stub",
        "content": [{"type": "text", "text": answer_text(digest, garbage, prompt)}]},
        "session_id": "stub-grok-session"})
    out({"type": "result", "subtype": "success", "is_error": False,
         "result": answer_text(digest, garbage, prompt), "num_turns": 2,
         "usage": {"input_tokens": 1100, "output_tokens": 140,
                   "cache_read_input_tokens": 0,
                   "cache_creation_input_tokens": 0}})


if __name__ == "__main__":
    main()
