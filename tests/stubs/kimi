#!/usr/bin/env python3
"""Заглушка kimi: печатает поток stream-json."""
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from stub_lib import (answer_text, digest_sources, fail_or_hang, is_digest,
                      journals_from,
                      mode, out, pause_if_slow)


def main() -> None:
    argv = sys.argv[1:]
    prompt = ""
    if "--prompt" in argv:
        prompt = argv[argv.index("--prompt") + 1]
    digest = is_digest(prompt) or any("digest-agent" in a for a in argv)
    garbage = mode() == "garbage"

    slow = fail_or_hang()
    paths = journals_from(digest_sources(prompt))
    if not paths:
        paths = ["/nonexistent/journal.jsonl"]
    # читаем до двух фрагментов: второй раз — первый журнал с offset
    paths = paths[:2] if len(paths) > 1 else [paths[0], paths[0]]
    out({"role": "meta", "type": "system.version", "version": "2.0.0-stub"})
    reads = [{"type": "function", "id": f"tool_{i}",
              "function": {"name": "Read",
                           "arguments": json.dumps({"path": path, "offset": i * 200})}}
             for i, path in enumerate(paths)]
    if slow:
        # по ходу: сначала часть событий, потом пауза, потом ответ
        for i, call in enumerate(reads):
            out({"role": "assistant", "tool_calls": [call]})
        pause_if_slow()
    else:
        for call in reads:
            out({"role": "assistant", "tool_calls": [call]})
            out({"role": "tool", "tool_call_id": call["id"],
                 "content": "строка журнала " + call["function"]["arguments"]})
    out({"role": "assistant", "content": answer_text(digest, garbage, prompt)})
    out({"role": "meta", "type": "session.resume_hint",
         "session_id": "session_stub", "command": "kimi -r session_stub",
         "content": "To resume this session: kimi -r session_stub"})


if __name__ == "__main__":
    main()
